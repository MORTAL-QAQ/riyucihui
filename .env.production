# AIGC多模态日语词汇学习 — 生产环境变量模板
# 复制此文件为 .env 并填入实际值
#
#   cp .env.production .env
#
# 然后编辑 .env，确保各项配置正确。

# ── 必填 ──

# DeepSeek API Key（用于 AI 生成单词和作文）
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# JWT 密钥（用于签发登录令牌，用 python -c "import secrets; print(secrets.token_urlsafe(32))" 生成）
SECRET_KEY=change-this-to-a-random-string

# ── 可选 ──

# DeepSeek API 配置
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 数据库（Docker 部署时使用以下 PostgreSQL 连接，无需修改）
DATABASE_URL=postgresql://jpvocab:jpvocab@postgres:5432/jpvocab

# VOICEVOX 语音合成（Docker 部署时无需修改）
VOICEVOX_BASE_URL=http://voicevox:50021
VOICEVOX_SPEAKER=1

# CORS 跨域（用 IP 访问时保持 *，绑定域名后改为具体域名）
CORS_ORIGINS=*

# Token 有效期（分钟），默认 7 天
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
