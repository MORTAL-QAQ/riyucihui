# DeepSeek API 配置 (OpenAI 兼容接口)
# 推荐: 存入系统凭据管理器，避免明文落地
#   python -c "import keyring; keyring.set_password('jp-vocab', 'DEEPSEEK_API_KEY', '<your-key>')"
# 备选: 直接写在下方（仅限本地开发，.gitignore 已排除 .env）
# DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 数据库
# 本地开发 (SQLite, 开箱即用):
DATABASE_URL=sqlite:///./data/words.db
# 生产部署 (PostgreSQL, docker compose 自动覆盖此配置):
# DATABASE_URL=postgresql://jpvocab:jpvocab@localhost:5432/jpvocab

# JWT 密钥（启动时若缺失会自动生成随机值，生产环境请提前设定）
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# VOICEVOX 语音合成
# 本地: http://localhost:50021
# Docker: http://voicevox:50021（由 docker-compose 自动设置）
VOICEVOX_BASE_URL=http://localhost:50021
VOICEVOX_SPEAKER=1
